ggsave("fig_dca_timecourse_overlay.pdf", fig_dca, width = 12, height = 10)





# === Area Under the Curve Calculation =================================================================
treatment_levels <- c("No Treatment", "Inhibitors", "UDCA", "Trp-UDCA", "Asp-UDCA", "Glu-UDCA", "Asn-UDCA", "Cit-UDCA", "DCA")

compute_mean_auc <- function(df) {
  mean_mfi <- df %>%
    group_by(protein, Treatment, Stimulation) %>%
    summarize(Mean_MFI = mean(MFI, na.rm = TRUE), .groups = "drop")
  auc_df <- mean_mfi %>%
    group_by(protein, Treatment) %>%
    summarize(AUC = auc(Stimulation, Mean_MFI), .groups = "drop")
  list(mean_mfi = mean_mfi, auc = auc_df)
}

compute_replicate_aucs <- function(df_long) {
  aucs <- lapply(unique(df_long$Replicate), function(r) {
    res <- compute_mean_auc(df_long %>% filter(Replicate == r))
    df <- res$auc
    names(df)[names(df) == "AUC"] <- paste0("AUC.", r)
    df
  })
  Reduce(function(x, y) full_join(x, y, by = c("protein", "Treatment")), aucs)
}



auc_replicates_wide <- compute_replicate_aucs(df_long)


AUCreplicates_long <- auc_replicates_wide %>%
  pivot_longer(
    cols = starts_with("AUC."),
    names_to = "Replicate",
    values_to = "AUC"
  ) %>%
  mutate(
    Replicate = sub("AUC_rep", "Replicate ", Replicate),
    protein = factor(protein, levels = c("pp38", "pERK", "IkBa")),
    Treatment = factor(Treatment, levels = treatment_levels),
    Replicate = factor(Replicate))



